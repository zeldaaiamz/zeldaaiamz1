        0,
        1
      ],
      "dates": [
        "",
        "2020-01-01"
      ],
      "expect": {
        "anomalies": 2,
        "old": false,
        "unknown": 1
      }
    },
    {
      "name": "garbage string kept",
      "hi": [
        0
      ],
      "dates": [
        "unknown"
      ],
      "expect": {
        "anomalies": 1,
        "old": false,
        "unknown": 1
      }
    },
