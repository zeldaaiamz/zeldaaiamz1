{
  "threshold": "2026-01-01",
  "reason": "高价品全部早于2026-01上架（老品赛道），不按高价异常入选",
  "cases": [
    {
      "name": "single old 2025-12-31 excluded",
      "hi": [
        0
      ],
      "dates": [
        "2025-12-31"
      ],
      "expect": {
        "anomalies": 0,
        "old": true,
        "unknown": 0,
        "priceFloor": true
      }
    },
    {
      "name": "single new 2026-01-01 kept (boundary)",
      "hi": [
        0
      ],
      "dates": [
        "2026-01-01"
      ],
      "expect": {
        "anomalies": 1,
        "old": false,
        "unknown": 0
      }
    },
    {
      "name": "multi all old excluded",
      "hi": [
        0,
        1
      ],
      "dates": [
        "2019-03-02",
        "2025-07-15"
      ],
      "expect": {
        "anomalies": 0,
        "old": true,
        "unknown": 0
      }
    },
    {
      "name": "multi one new kept",
      "hi": [
        0,
        1
      ],
      "dates": [
        "2019-03-02",
        "2026-02-10"
      ],
      "expect": {
        "anomalies": 2,
        "old": false,
        "unknown": 0
      }
    },
    {
      "name": "missing null kept",
      "hi": [
        0
      ],
      "dates": [
        null
      ],
      "expect": {
        "anomalies": 1,
        "old": false,
        "unknown": 1
      }
    },
    {
      "name": "missing empty + old kept (missing not treated as old)",
